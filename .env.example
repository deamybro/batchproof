# Hedera Network Configuration
# Set to 'testnet' or 'mainnet'
HEDERA_NETWORK=testnet

# Hedera Operator Account ID (e.g., 0.0.1234567)
# Required when DEMO_MODE=false
HEDERA_OPERATOR_ID=0.0.1234567

# Hedera Operator ECDSA or ED25519 Private Key (DER or HEX encoded)
# Required when DEMO_MODE=false. NEVER expose this in client-side code!
HEDERA_OPERATOR_KEY=302e020100300506032b657004220420...

# Hedera Consensus Service (HCS) Topic ID for BatchProof audit logs (e.g., 0.0.7654321)
# Create one with `npm run hedera:setup` or Hedera Developer Portal
HEDERA_TOPIC_ID=0.0.7654321

# Demo Mode Flag
# Set to true to run fully offline without Hedera credentials using realistic seeded sample data
# Set to false to publish real tamper-evident batch audit records to Hedera Testnet
DEMO_MODE=true
